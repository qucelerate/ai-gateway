{
  "openapi": "3.1.0",
  "info": {
    "title": "Gateway admin budgets API",
    "version": "1.0.0",
    "description": "Spending budgets for inference, per organization, team, service account and API key, in money units of one currency (10⁻⁶ of its smallest unit, so $100 is `10000000000`). Authenticated with a session cookie or an agent token (`Authorization: Bearer gwa_…`), which acts only in its agent's organization. A budget repeats each calendar month in UTC (`monthly`) or covers one window (`fixed`, `[starts_at, ends_at)`). Every budget covering a request applies: the organization's, the team's of the key's team, the service account's, and the key's own. Each request reserves its largest possible cost against all of them and is settled at its actual cost; a request that does not fit, or that no budget covers, is refused with `quota_exceeded`. A request in another currency than a budget is not covered by it. A budget bounds what the gateway calculates from provider-reported usage and catalog prices, not the provider's invoice: usage past a reservation (a `bound-breach` reconciliation item), requests whose outcome is unknown, prices that differ from the provider's, and calls made outside the gateway can all make the provider bill more than the budget allows. Pair budgets with the provider's own spending limits."
  },
  "security": [
    {
      "session": []
    },
    {
      "agentToken": []
    }
  ],
  "paths": {
    "/api/admin/v1/organizations/{org}/budgets": {
      "get": {
        "operationId": "listBudgetPolicies",
        "summary": "List the organization's budgets",
        "description": "Permission `budget_read` (owner, admin, operator, auditor, read-only member; org-wide only). Not audited. Every budget of the organization, ordered by id, with what its current window has used.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "description": "Opaque signed token from `next_page_token`; bound to the actor, organization, and ordering.",
            "schema": {
              "type": "string",
              "maxLength": 4096
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of policies.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetPolicyPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/admin/v1/organizations/{org}/budgets/organization": {
      "put": {
        "operationId": "setOrganizationBudget",
        "summary": "Set the organization's budget",
        "description": "Permission `budget_write` (owner, admin; org-wide only). Audited as `budget_policy.set`. Creates or replaces the budget of the organization, which covers every request of the organization. Changing the limit applies to the current window at once and keeps what it has spent; changing the currency, period or window starts a new balance. Requests already admitted are settled against the budget they were admitted under.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Client-chosen key. A retry with the same key and request replays the stored outcome; a different request under the same key is `idempotency_conflict`.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "`*` for any state, or the budget's current `ETag`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BudgetInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "ETag": {
                "description": "Resource version, `\"v{version}\"`.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"v[0-9]+\"$"
