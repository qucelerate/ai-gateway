        "operationId": "listRateLimitPolicies",
        "summary": "Rate-limit policies",
        "description": "Permission `rate_limit_read` (owner, admin, operator, auditor, read-only member; org-wide only). Not audited. Every policy of the organization, ordered by id.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "description": "Opaque signed token from `next_page_token`; bound to the actor, organization, and ordering.",
            "schema": {
              "type": "string",
              "maxLength": 4096
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of policies.",
