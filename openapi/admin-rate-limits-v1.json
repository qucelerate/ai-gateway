          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "415": {
            "description": "`request_body_invalid`: body is not `application/json`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "`invalid_rate_limit`: no limit is set, `requests_per_minute` or `max_concurrent` is outside 1..1000000, or `tokens_per_minute` is outside 1..1000000000; `request_body_unprocessable`: unknown field or wrong type.",
