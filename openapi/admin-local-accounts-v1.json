            "session": []
          }
        ],
        "summary": "An owner's password-reset link for a member",
        "description": "Owners only, from a browser session with the CSRF token (agent tokens are refused). The member must have a local account, belong to no organization the owner does not own, and not administer the deployment unless the owner does; otherwise only the operator can reset them (`gateway user reset-password`). The link is in this response only; it works once, for 24 hours. Audited as `membership.password_reset_link_created`.",
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "user_id",
            "in": "path",
