                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`local_accounts_disabled`: this gateway does not offer password accounts.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/v1/password/reset": {
      "post": {
        "operationId": "resetPassword",
        "security": [],
        "summary": "Set a new password with a reset link",
        "description": "Every session of the account ends; the person then signs in. A link works once, for 24 hours, and a newer link for the same account replaces it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "token",
                  "password"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "The token from the link's fragment (`#token=\u2026`)."
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 256
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Set."
          },
          "403": {
            "description": "`cross_origin_request_refused`: a browser request from another origin than `GATEWAY_ORIGIN`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`reset_link_invalid` or `local_accounts_disabled`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The password is refused: `password_too_short`, `password_too_long`, `password_too_common`, `password_contains_email` or `password_too_repetitive`, with a sentence in `detail`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "`sign_in_busy`: too many passwords are being checked at once; retry after `Retry-After`. `auth_store_unavailable`: the store is unreachable.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/v1/invitations/inspect": {
      "post": {
        "operationId": "inspectInvitation",
        "security": [],
        "summary": "What an invitation offers its holder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "The token from the link's fragment (`#token=\u2026`)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "organization_name",
                    "role",
                    "password",
                    "sso"
                  ],
                  "properties": {
                    "organization_name": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "owner",
                        "admin",
                        "member",
                        "auditor",
                        "read-only"
                      ]
                    },
                    "password": {
                      "type": "boolean",
                      "description": "It may be accepted with a local account: local accounts are on, it is not bound to the organization's own identity provider, and the organization does not require that provider."
                    },
                    "sso": {
                      "type": "boolean",
                      "description": "It may be accepted by signing in with the identity provider it names: open `/api/admin/v1/invitations/accept?token=\u2026&method=sso`."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "`cross_origin_request_refused`: a browser request from another origin than `GATEWAY_ORIGIN`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`invitation_invalid`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
