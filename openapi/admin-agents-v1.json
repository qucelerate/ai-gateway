{
  "openapi": "3.1.0",
  "info": {
    "title": "Gateway admin agents API",
    "version": "1.0.0",
    "description": "Agents are an organization's non-human administrators: automation (CI, coding agents, the `gwctl` CLI, and later an MCP server) drives the admin API with them, headlessly, instead of a browser session. An agent is a user account with no sign-in identity and a member of exactly one organization, so its role, the permission checks and the audit trail work as they do for a person.\n\nAn agent authenticates with an agent token, `Authorization: Bearer gwa_…`, on any admin route under `/api/admin/v1/organizations/{org}/…` for its own organization, plus `GET /api/admin/v1/me` and `GET /api/admin/v1/organizations` (which lists only that organization). Any other organization answers `404`. Writes need no browser headers. Only a SHA-256 digest of a token is stored; the token is returned once, in the response that created it, and never logged, audited or replayed. Tokens expire after `expires_in_days` (1 to 365) or never. A token created with `service_account_id` is limited to that service account's end-user settings, plans and users, so an app's backend can manage its own end users and nothing else (`403 service_account_token_scope` elsewhere); an agent holds at most 20 live tokens and an organization at most 200 agents. Disabling an agent revokes all of its tokens.\n\nReading needs the permission to list members (owner, admin, auditor); writing needs the permission to change members (owner, admin). A caller may only create an agent, or mint a token for one, whose role is at or below their own (`role_escalation_denied`), so an admin agent cannot mint an owner. Operators create an organization's first agent on the server with `gateway agent create`, which prints its token once."
  },
  "security": [
    {
      "session": []
    },
    {
      "agentToken": []
    }
  ],
  "paths": {
    "/api/admin/v1/organizations/{org}/agents": {
      "get": {
        "operationId": "listAgents",
        "summary": "List agents",
        "description": "Every agent in the organization, disabled ones included, with its tokens' metadata, and the roles the caller may grant.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The agents.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "`not_found`: no such organization, agent or token in the caller's scope. An agent token answers `404` for any other organization.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "post": {
        "operationId": "createAgent",
        "summary": "Create an agent",
        "description": "Creates an agent with the given role. It has no token yet: mint one with `POST …/agents/{agent_id}/tokens`.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Client-chosen key. A retry with the same key and request replays the stored outcome; a different request under the same key is `idempotency_conflict`.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            }
          },
          "200": {
            "description": "Idempotent replay.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/WriteBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "description": "`forbidden`: the caller may not change members; or `role_escalation_denied`: the role is above the caller's own.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`: no such organization, agent or token in the caller's scope. An agent token answers `404` for any other organization.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`agent_name_taken` or `too_many_agents`; also `idempotency_conflict` or `idempotency_in_progress`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "description": "`invalid_agent`: a name or description that is empty, too long, padded with spaces or has control characters, or an unknown role; also `request_body_invalid` for unknown fields.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
