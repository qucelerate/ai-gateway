{
  "openapi": "3.1.0",
  "info": {
    "title": "Gateway admin configuration versions API",
    "version": "1.0.0",
    "description": "Configuration versions: the routing configuration (the active catalog release's routes and the live price overrides) every API-serving instance loads and serves from memory. A version is published in the same transaction as each change to those inputs. Pinning an organization to an earlier version makes every instance serve it until unpinned; changes made while pinned are still published but not served. Access controls (keys, credentials, budgets, limits) are not versioned and are never rolled back by a pin. Authenticated with a session cookie or an agent token (`Authorization: Bearer gwa_\u2026`), which acts only in its agent's organization."
  },
  "security": [
    {
      "session": []
    },
    {
      "agentToken": []
    }
  ],
  "paths": {
    "/api/admin/v1/organizations/{org}/config-versions": {
      "get": {
        "operationId": "listConfigVersions",
        "summary": "Configuration versions",
        "description": "Permission `catalog_read` (owner, admin, operator, auditor; org-wide only). Not audited. The organization's versions, newest first. Versions older than 90 days are swept, except the newest and the pinned one.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "description": "Opaque signed token from `next_page_token`; bound to the actor, organization, and ordering.",
            "schema": {
              "type": "string",
              "maxLength": 4096
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of versions.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigVersionPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/admin/v1/organizations/{org}/config-versions/pin": {
      "get": {
        "operationId": "getConfigPin",
        "summary": "The organization's pin",
        "description": "Permission `catalog_read`. Not audited. The pinned, served and newest versions.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The pin.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "ETag": {
                "description": "The pin's resource version, `\"v{version}\"`.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"v[0-9]+\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigPin"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "put": {
        "operationId": "pinConfigVersion",
        "summary": "Pin a version",
        "description": "Permission `catalog_write` (owner, admin; org-wide only). Audited as `config_pin.set`, naming the version. Every instance serves the version once it applies the pin, until the organization is unpinned or pinned to another version.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Client-chosen key. A retry with the same key and request replays the stored outcome; a different request under the same key is `idempotency_conflict`.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "`*` for any state, `\"v0\"` if the organization has never been pinned, or the pin's current `ETag`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigPinInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pinned, or an idempotent replay of the recorded response.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "ETag": {
                "description": "The pin's resource version, `\"v{version}\"`.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"v[0-9]+\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigPin"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/WriteBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "415": {
            "description": "`request_body_invalid`: body is not `application/json`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "`request_body_unprocessable`: unknown field or wrong type.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "unpinConfigVersion",
        "summary": "Unpin",
        "description": "Permission `catalog_write`. Audited as `config_pin.deleted`. Every instance serves the newest version again once it applies the change.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Client-chosen key. A retry with the same key and request replays the stored outcome; a different request under the same key is `idempotency_conflict`.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "`*` for any state, `\"v0\"` if the organization has never been pinned, or the pin's current `ETag`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Unpinned, or an idempotent replay of the recorded response.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "ETag": {
                "description": "The pin's resource version, `\"v{version}\"`.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"v[0-9]+\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigPin"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/WriteBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "409": {
            "description": "`config_not_pinned`, `version_conflict`, `idempotency_conflict`, or `idempotency_in_progress`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/v1/organizations/{org}/config-instances": {
      "get": {
        "operationId": "listConfigInstances",
        "summary": "Instances and what they serve",
        "description": "Permission `catalog_read`. Not audited. Every API-serving instance (all-in-one, api, data-plane) seen in the last seven days, with the version it serves the organization at the feed position it has applied. An instance whose `serving_version_id` differs from the pin's `served_version_id` has not caught up.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Every instance, by id.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigInstancePage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-gateway_session",
        "description": "Paired with the `__Host-gateway_oidc_browser` binding cookie."
      },
      "agentToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "gwa_\u2026",
        "description": "An agent token (`Authorization: Bearer gwa_\u2026`), for automation: it acts as its agent, only in the agent's organization, with the agent's role. Created with `POST /api/admin/v1/organizations/{org}/agents/{agent_id}/tokens` or, on the server, `gateway agent create`."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid query (`invalid_query`) or page token (`invalid_page_token`, `invalid_page_token_signature`, `page_token_scope_mismatch`, `page_token_query_mismatch`, `page_token_too_large`, `pagination_limit_invalid`).",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthenticated": {
        "description": "`authentication_required`.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "`forbidden`: the actor lacks the required permission for the organization.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unavailable": {
        "description": "`service_unavailable` or `authentication_unavailable`.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Conflict": {
        "description": "`version_conflict` (stale `If-Match`), `idempotency_conflict`, or `idempotency_in_progress`.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "PreconditionRequired": {
        "description": "`if_match_required`: the `If-Match` header is missing.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "WriteBadRequest": {
        "description": "`idempotency_key_required`, `idempotency_key_invalid`, `if_match_invalid`, or a malformed JSON body (`request_body_invalid`).",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "`not_found`: the version does not exist in the organization.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "code",
          "title",
          "status",
          "detail",
          "instance",
          "request_id"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "ConfigVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sequence",
          "digest",
          "release_id",
          "routes",
          "overrides",
          "served",
          "pinned",
          "newest",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "description": "Feed position the version was published at; the list's order."
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Hex SHA-256 of the version's document."
          },
          "release_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The catalog release it routes from; null when no release was active."
          },
          "routes": {
            "type": "integer",
            "minimum": 0
          },
          "overrides": {
            "type": "integer",
            "minimum": 0,
            "description": "Price overrides it carries, with their windows."
          },
          "served": {
            "type": "boolean",
            "description": "Served now: the pinned version while pinned, otherwise the newest."
          },
          "pinned": {
            "type": "boolean"
          },
          "newest": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ConfigVersionPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "next_page_token"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConfigVersion"
            }
          },
          "next_page_token": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ConfigPin": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pinned_version_id",
          "served_version_id",
          "newest_version_id",
          "version"
        ],
        "properties": {
          "pinned_version_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The version the organization is pinned to; null when not pinned."
          },
          "served_version_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "newest_version_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "description": "The pin's resource version (the ETag); 0 before the first pin."
          }
        }
      },
      "ConfigPinInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version_id"
        ],
        "properties": {
          "version_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ConfigInstance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instance_id",
          "profile",
          "region",
          "build",
          "applied_sequence",
          "serving_version_id",
          "loaded_at",
          "started_at",
          "last_seen_at",
          "stale"
        ],
        "properties": {
          "instance_id": {
            "type": "string"
          },
          "profile": {
            "type": "string",
            "enum": [
              "all-in-one",
              "api",
              "data-plane"
            ]
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "build": {
            "type": "string",
            "description": "Image commit."
          },
          "applied_sequence": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Feed position applied; null before the first load."
          },
          "serving_version_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The version it serves the organization at its applied position."
          },
          "loaded_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "stale": {
            "type": "boolean",
            "description": "Unseen for five minutes."
          }
        }
      },
      "ConfigInstancePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "next_page_token"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConfigInstance"
            }
          },
          "next_page_token": {
            "type": "null",
            "description": "Always null: every instance is returned."
          }
        }
      }
    }
  }
}
