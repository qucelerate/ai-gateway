{
  "openapi": "3.1.0",
  "info": {
    "title": "Gateway Inference API",
    "version": "1.0.0",
    "description": "Stable since 1.0.0 (2026-11-06). Within `/api/inference/v1/` the contract changes only compatibly: new endpoints, new optional request fields, new response fields, new SSE event names, and new values of open strings such as `finish_reason` and problem `code`. Clients must ignore response fields and SSE events they do not know. A breaking change ships under a new URL version alongside this one. See the compatibility policy in the reference documentation."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "gatewayApiKey": []
    }
  ],
  "paths": {
    "/api/inference/v1/chat/completions": {
      "post": {
        "operationId": "chatCompletionsV1",
        "security": [
          {
            "gatewayApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Bounded chat request",
                  "value": {
                    "model": "chat-default",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Hello"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed chat response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                },
                "examples": {
                  "completed": {
                    "summary": "Completed response",
                    "value": {
                      "id": "request-id",
                      "model": "chat-default",
                      "choices": [],
                      "usage": null
                    }
                  }
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem400"
          },
          "401": {
            "$ref": "#/components/responses/Problem401"
          },
          "403": {
            "$ref": "#/components/responses/Problem403"
          },
          "404": {
            "$ref": "#/components/responses/Problem404"
          },
          "409": {
            "$ref": "#/components/responses/Problem409"
          },
          "413": {
            "$ref": "#/components/responses/Problem413"
          },
          "415": {
            "$ref": "#/components/responses/Problem415"
          },
          "422": {
            "$ref": "#/components/responses/Problem422"
          },
          "429": {
            "$ref": "#/components/responses/Problem429"
          },
          "502": {
            "$ref": "#/components/responses/Problem502"
          },
          "503": {
            "$ref": "#/components/responses/Problem503"
          },
          "504": {
            "$ref": "#/components/responses/Problem504"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/inference/v1/chat/completions/stream": {
      "post": {
        "operationId": "chatCompletionsStreamV1",
        "security": [
          {
            "gatewayApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Named, non-resumable SSE events",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                },
                "examples": {
                  "completed": {
                    "value": "event: response.started\ndata: {\"model\":\"chat-default\"}\n\nevent: response.completed\ndata: {\"model\":\"chat-default\",\"usage\":null}\n\n",
                    "x-fixture": "fixtures/sse/chat-completed.sse"
                  },
                  "provider-error": {
                    "value": "event: error\ndata: {\"code\":\"provider_error\",\"status\":502}\n\n",
                    "x-fixture": "fixtures/sse/chat-error.sse"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem400"
          },
          "401": {
            "$ref": "#/components/responses/Problem401"
          },
          "403": {
            "$ref": "#/components/responses/Problem403"
          },
          "404": {
            "$ref": "#/components/responses/Problem404"
          },
          "409": {
            "$ref": "#/components/responses/Problem409"
          },
          "413": {
            "$ref": "#/components/responses/Problem413"
          },
          "415": {
            "$ref": "#/components/responses/Problem415"
          },
          "422": {
            "$ref": "#/components/responses/Problem422"
          },
          "429": {
            "$ref": "#/components/responses/Problem429"
          },
          "502": {
            "$ref": "#/components/responses/Problem502"
          },
          "503": {
            "$ref": "#/components/responses/Problem503"
          },
          "504": {
            "$ref": "#/components/responses/Problem504"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-sse-events": [
          {
            "name": "response.started",
            "terminal": false,
            "schema": {
              "$ref": "#/components/schemas/SseResponseStarted"
            }
          },
          {
            "name": "choice.delta",
            "terminal": false,
            "schema": {
              "$ref": "#/components/schemas/SseChoiceDelta"
            }
          },
          {
            "name": "tool_call.delta",
            "terminal": false,
            "schema": {
              "$ref": "#/components/schemas/SseToolCallDelta"
            }
          },
          {
            "name": "choice.finished",
            "terminal": false,
            "schema": {
              "$ref": "#/components/schemas/SseChoiceFinished"
            }
          },
          {
            "name": "safety.annotation",
            "terminal": false,
            "schema": {
              "$ref": "#/components/schemas/SseSafetyAnnotation"
            }
          },
          {
            "name": "usage",
            "terminal": false,
            "schema": {
              "$ref": "#/components/schemas/SseUsage"
            }
          },
          {
            "name": "response.completed",
            "terminal": true,
            "schema": {
              "$ref": "#/components/schemas/SseResponseCompleted"
            }
          },
          {
            "name": "error",
            "terminal": true,
            "schema": {
              "$ref": "#/components/schemas/SseError"
            }
          }
        ],
        "x-resumable": false
      }
    },
