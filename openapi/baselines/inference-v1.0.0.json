            "$ref": "#/components/responses/Problem504"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "gatewayApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "gw_ API key"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "RequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "Gateway correlation identifier",
        "schema": {
          "type": "string"
        }
      },
      "WWW-Authenticate": {
        "description": "Bearer authentication challenge",
        "schema": {
          "type": "string",
          "const": "Bearer"
        }
      },
      "Retry-After": {
        "description": "Whole seconds to wait before retrying a request rejected by a rate or concurrency limit, or by an open provider circuit",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "RFC 9457 problem",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "Problem400": {
        "description": "Bad Request",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Problem401": {
        "description": "Unauthorized",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "WWW-Authenticate": {
            "$ref": "#/components/headers/WWW-Authenticate"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Problem403": {
        "description": "Forbidden",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Problem404": {
        "description": "Not Found",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "examples": {
              "unknownCatalogAlias": {
                "summary": "Unknown catalog alias",
                "value": {
                  "type": "https://gateway.invalid/problems/model_unavailable",
                  "code": "model_unavailable",
                  "title": "Not Found",
                  "status": 404,
                  "detail": "model alias is not available for this operation",
                  "instance": "/api/inference/v1/chat/completions",
                  "request_id": "request-id"
                }
              }
            }
          }
        }
      },
      "Problem409": {
        "description": "Conflict",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Problem413": {
        "description": "Payload Too Large",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Problem415": {
        "description": "Unsupported Media Type",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Problem422": {
        "description": "Unprocessable Entity",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Problem429": {
        "description": "Too Many Requests: a quota is exhausted (`quota_exceeded`), or a rate limit (`rate_limit_exceeded`) or concurrency limit (`concurrency_limit_exceeded`) is reached. Limit rejections carry `Retry-After`.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Retry-After": {
            "$ref": "#/components/headers/Retry-After"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Problem502": {
        "description": "Bad Gateway",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Problem503": {
        "description": "Service Unavailable. The code `provider_circuit_open` means the deployment has failed repeatedly and requests to it are refused without calling the provider; it carries `Retry-After`.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Retry-After": {
            "$ref": "#/components/headers/Retry-After"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Problem504": {
        "description": "Gateway Timeout",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        }
      },
      "Message": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "developer",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 131072
          }
        }
      },
      "ChatResponse": {
        "type": "object",
        "required": [
          "id",
          "model",
          "choices"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Choice"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "EmbeddingRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "input": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 131072
            }
          }
        }
      },
      "EmbeddingResponse": {
        "type": "object",
        "required": [
          "object",
          "model",
          "data"
        ],
        "properties": {
          "object": {
            "const": "list"
          },
          "model": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "object",
                "index",
                "embedding"
              ],
              "properties": {
                "object": {
                  "const": "embedding"
                },
                "index": {
                  "type": "integer"
                },
                "embedding": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "Usage": {
        "type": "object",
        "properties": {
          "input_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "output_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cached_input_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "reasoning_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "other_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "quality": {
            "type": "string",
            "enum": [
              "exact",
              "estimated",
              "unknown"
            ]
          },
          "completeness": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unavailable"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "code",
          "title",
          "status",
          "detail",
          "instance",
          "request_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "Choice": {
        "type": "object",
        "required": [
          "index",
          "message",
          "finish_reason",
          "tool_calls",
          "refusal",
          "safety",
          "annotations"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "$ref": "#/components/schemas/MessageResponse"
          },
          "finish_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool_calls": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "refusal": {
            "type": [
              "string",
              "null"
            ]
          },
          "safety": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "annotations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool_call_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SseResponseStarted": {
        "type": "object",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string"
          }
        }
      },
      "SseChoiceDelta": {
        "type": "object",
        "required": [
          "choice_index",
          "content_delta",
          "refusal_delta",
          "annotations"
        ],
        "properties": {
          "choice_index": {
            "type": "integer",
            "minimum": 0
          },
          "content_delta": {
            "type": [
              "string",
              "null"
            ]
          },
          "refusal_delta": {
            "type": [
              "string",
              "null"
            ]
          },
          "annotations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Annotation"
            }
          }
        }
      },
      "SseToolCallDelta": {
        "type": "object",
        "required": [
          "choice_index",
          "tool_call_index",
          "id",
          "name",
          "arguments_delta"
        ],
        "properties": {
          "choice_index": {
            "type": "integer",
