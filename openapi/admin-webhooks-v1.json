    "/api/admin/v1/organizations/{org}/webhook-endpoints/{endpoint_id}/rotate-secret": {
      "post": {
        "operationId": "rotateWebhookSecret",
        "summary": "Rotate an endpoint's signing secret",
        "description": "Permission `webhook_write` (owner, admin; org-wide only). Audited as `webhook_endpoint.secret_rotated`. Replaces the signing secret, returned in this response only. The old secret stops signing later attempts, including those of pending deliveries; an attempt already in progress may still be signed with it. An idempotent replay returns `secret: null` with `error: \"secret_unavailable_on_replay\"`.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "endpoint_id",
            "in": "path",
            "required": true,
            "description": "Webhook endpoint id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Client-chosen key. A retry with the same key and request replays the stored outcome; a different request under the same key is `idempotency_conflict`.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "`*` for any state, or the endpoint's current `ETag`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rotated; `secret` holds the new signing secret unless `replay` is true.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "ETag": {
                "description": "Resource version, `\"v{version}\"`.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"v[0-9]+\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookSecretResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/WriteBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "503": {
            "$ref": "#/components/responses/SecretUnavailable"
          }
        }
      }
    },
