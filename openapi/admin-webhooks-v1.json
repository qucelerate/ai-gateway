      "patch": {
        "operationId": "updateWebhookEndpoint",
        "summary": "Update a webhook endpoint",
        "description": "Permission `webhook_write` (owner, admin; org-wide only). Audited as `webhook_endpoint.updated`. Changes only the fields present; an empty `description` clears it. Subscriptions and the enabled flag apply to events dispatched after the change. Disabling an endpoint stops new deliveries to it and pauses pending ones until it is enabled again. A URL change applies to later attempts; an attempt already in progress may complete against the previous URL.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "endpoint_id",
            "in": "path",
