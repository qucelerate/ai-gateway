    "/api/admin/v1/organizations/{org}/webhook-endpoints/{endpoint_id}/deliveries/{delivery_id}/redeliver": {
      "post": {
        "operationId": "redeliverWebhookDelivery",
        "summary": "Redeliver a parked delivery",
        "description": "Permission `webhook_write` (owner, admin; org-wide only). Audited as `webhook_delivery.redelivered`. Returns a parked delivery to `pending`, due at once, for a fresh run of 24 attempts with backoff starting over; `attempts` keeps counting across runs; `last_status_code` and `last_error` keep the last outcome until the next attempt. Deliveries to a disabled endpoint wait until it is enabled. The payload and event id are unchanged, so receivers deduplicate a redelivery by `webhook-id` like any retry. `If-Match` is not used: the delivery must be parked. An idempotent replay returns the recorded response.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "endpoint_id",
            "in": "path",
            "required": true,
            "description": "Webhook endpoint id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "delivery_id",
            "in": "path",
            "required": true,
            "description": "Webhook delivery id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Client-chosen key. A retry with the same key and request replays the stored outcome; a different request under the same key is `idempotency_conflict`.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The delivery, now pending; or an idempotent replay.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookDelivery"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/WriteBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "`not_found`: the endpoint or delivery does not exist in the organization.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`webhook_delivery_not_parked` (the delivery is pending or delivered), `idempotency_conflict`, or `idempotency_in_progress`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-gateway_session",
        "description": "Paired with the `__Host-gateway_oidc_browser` binding cookie."
      },
      "agentToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "gwa_\u2026",
        "description": "An agent token (`Authorization: Bearer gwa_\u2026`), for automation: it acts as its agent, only in the agent's organization, with the agent's role. Created with `POST /api/admin/v1/organizations/{org}/agents/{agent_id}/tokens` or, on the server, `gateway agent create`."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid query (`invalid_query`) or page token (`invalid_page_token`, `invalid_page_token_signature`, `page_token_scope_mismatch`, `page_token_query_mismatch`, `page_token_too_large`, `pagination_limit_invalid`).",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthenticated": {
        "description": "`authentication_required`.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "`forbidden`: the actor lacks the required permission for the organization.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unavailable": {
        "description": "`service_unavailable` or `authentication_unavailable`.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Conflict": {
        "description": "`version_conflict` (stale `If-Match`), `idempotency_conflict`, or `idempotency_in_progress`.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "PreconditionRequired": {
        "description": "`if_match_required`: the `If-Match` header is missing.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "WriteBadRequest": {
        "description": "`idempotency_key_required`, `idempotency_key_invalid`, `if_match_invalid`, or a malformed JSON body (`request_body_invalid`).",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "`not_found`: the endpoint does not exist in the organization.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Invalid": {
        "description": "`invalid_webhook_endpoint`: the URL is not an https URL to a public host, contains credentials or a fragment, or a description or event type list is invalid; also `request_body_invalid` for unknown fields.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "`request_body_invalid`: the body is not `application/json`.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "SecretUnavailable": {
        "description": "`credential_encryption_unavailable`: no credential encryption key is configured, so signing secrets cannot be stored; or `service_unavailable` / `authentication_unavailable`.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "code",
          "title",
          "status",
          "detail",
          "instance",
          "request_id"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "EventType": {
        "type": "string",
        "enum": [
          "inference.finalized",
          "reconciliation.opened",
          "reconciliation.updated",
          "reconciliation.resolved",
          "usage_export.failing",
          "notification.created"
        ]
      },
      "WebhookEndpointInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "event_types"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "pattern": "^https://",
            "description": "An https URL to a public host, without credentials or a fragment. Literal private, loopback, link-local and documentation addresses and single-label or `localhost` hosts are rejected; every address the host resolves to is checked again at each delivery."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200
          },
          "event_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/EventType"
            }
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "WebhookEndpointUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "pattern": "^https://",
            "description": "An https URL to a public host, without credentials or a fragment. Literal private, loopback, link-local and documentation addresses and single-label or `localhost` hosts are rejected; every address the host resolves to is checked again at each delivery."
          },
          "description": {
            "type": "string",
            "maxLength": 200,
            "description": "An empty string clears the description."
          },
          "event_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/EventType"
            }
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "WebhookEndpoint": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "description",
          "event_types",
          "enabled",
          "created_at",
          "updated_at",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventType"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "WebhookSecretResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoint",
          "secret",
          "replay",
          "error"
        ],
        "properties": {
          "endpoint": {
            "$ref": "#/components/schemas/WebhookEndpoint"
          },
          "secret": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^whsec_",
            "description": "The signing secret, `whsec_` followed by base64 of 32 random bytes. Returned once; store it now."
          },
          "replay": {
            "type": "boolean"
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "secret_unavailable_on_replay",
              null
            ]
          }
        }
      },
      "WebhookEndpointPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "next_page_token"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebhookEndpoint"
            }
          },
          "next_page_token": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "WebhookDelivery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event_id",
          "event_type",
          "status",
          "attempts",
          "next_attempt_at",
          "last_attempt_at",
          "last_status_code",
          "last_error",
          "delivered_at",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "event_id": {
            "type": "string",
            "format": "uuid",
            "description": "The event id, also sent as `webhook-id` and the envelope `id`; receivers deduplicate by it."
          },
          "event_type": {
            "$ref": "#/components/schemas/EventType"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "delivered",
              "parked"
            ],
            "description": "`parked` after 24 failed attempts; it is not retried unless redelivered."
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "description": "Attempts made, across every run; a redelivery does not reset it."
          },
          "next_attempt_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When a pending delivery is next attempted; null once finished."
          },
          "last_attempt_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_status_code": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 100,
            "maximum": 599
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "description": "A fixed phrase such as `connection failed` or `request timed out`; never the response body."
          },
          "delivered_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WebhookDeliveryPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "next_page_token"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebhookDelivery"
            }
          },
          "next_page_token": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "NotificationCreated": {
        "type": "object",
        "additionalProperties": false,
        "description": "`data` of a `notification.created` event.",
        "required": [
          "notification_id",
          "kind",
          "severity",
          "subject",
          "title",
          "body",
          "link",
          "data",
          "required_permission",
          "created_at"
        ],
        "properties": {
          "notification_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "description": "The notification's kind (see `openapi/admin-notifications-v1.json`); new ones may be added.",
            "examples": [
              "budget.threshold",
              "webhook.failing",
              "end_user.credits_low",
              "reconciliation.open"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "action"
            ]
          },
          "subject": {
            "type": "string",
            "maxLength": 256,
            "description": "What it is about, within its kind."
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "maxLength": 2000
          },
          "link": {
            "type": [
              "string",
              "null"
            ],
            "description": "A console path (`/admin/...`)."
          },
          "data": {
            "type": "object",
            "description": "The kind's data."
          },
          "required_permission": {
            "type": "string",
            "description": "The permission a member needs to see it in the console."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
