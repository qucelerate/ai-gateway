                "schema": {
                  "type": "string",
                  "pattern": "^\"v[0-9]+\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEndpoint"
                }
              }
            }
