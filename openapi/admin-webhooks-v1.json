{
  "openapi": "3.1.0",
  "info": {
    "title": "Gateway admin webhooks API",
    "version": "1.0.0",
    "description": "Webhook endpoints receive the organization's outbox events (`inference.finalized`, `reconciliation.opened`, `reconciliation.updated`, `reconciliation.resolved`, `usage_export.failing`, `notification.created`). `reconciliation.updated` reports that an open item opened by expiry recovery (`expired-after-claim`) took the reason of a finalization that arrived later; `data` is `{item_id, reservation_id, previous_reason, reason, updated_at}` and the item stays open. `usage_export.failing` reports that the organization's usage export has failed to write for an hour; `data` is `{export_id, kind, failing_since, last_error, queued_records}` (see `openapi/admin-usage-export-v1.json`), and it is sent once until a write succeeds or the destination changes. `notification.created` reports a notification newly raised in the organization (a condition opened, or an event recorded; a condition raised again while open is not sent again); `data` is `NotificationCreated`. It carries the notification's text, which names the resources it is about (a team, a service account, a webhook host), and is sent whatever permission a member would need to see it in the console (`required_permission`). Authenticated with a session cookie or an agent token (`Authorization: Bearer gwa_\u2026`), which acts only in its agent's organization.\n\nDelivery: each event is POSTed as JSON `{id, type, organization_id, occurred_at, data}` and signed per Standard Webhooks: headers `webhook-id` (the event id), `webhook-timestamp` (Unix seconds) and `webhook-signature` (`v1,` followed by the base64 HMAC-SHA256 of `{webhook-id}.{webhook-timestamp}.{body}`, keyed with the base64-decoded part of the `whsec_` secret). Any 2xx response acknowledges the delivery. Other responses, timeouts and connection failures are retried with exponential backoff from 5 seconds up to 1 hour; after 24 attempts the delivery is parked until an operator redelivers it. Delivery is at least once and not ordered, so receivers deduplicate by `webhook-id`. Redirects are not followed, and connections are made only to public addresses."
  },
  "security": [
    {
      "session": []
    },
    {
      "agentToken": []
    }
  ],
  "paths": {
    "/api/admin/v1/organizations/{org}/webhook-endpoints": {
      "get": {
        "operationId": "listWebhookEndpoints",
        "summary": "Webhook endpoints",
        "description": "Permission `webhook_read` (owner, admin, operator, auditor, read-only member; org-wide only). Not audited. Every endpoint of the organization, ordered by id. Signing secrets are never returned.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "description": "Opaque signed token from `next_page_token`; bound to the actor, organization, and ordering.",
            "schema": {
              "type": "string",
              "maxLength": 4096
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of endpoints.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEndpointPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "post": {
        "operationId": "createWebhookEndpoint",
        "summary": "Create a webhook endpoint",
        "description": "Permission `webhook_write` (owner, admin; org-wide only). Audited as `webhook_endpoint.created`. Creates an endpoint with a new signing secret, which is returned in this response only; an idempotent replay returns the endpoint with `secret: null`, `replay: true`, and `error: \"secret_unavailable_on_replay\"`. An organization has at most 20 endpoints. The endpoint receives events that occur after it is created.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Client-chosen key. A retry with the same key and request replays the stored outcome; a different request under the same key is `idempotency_conflict`.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEndpointInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created; `secret` holds the signing secret.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "ETag": {
                "description": "Resource version, `\"v{version}\"`.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"v[0-9]+\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookSecretResponse"
                }
              }
            }
          },
          "200": {
            "description": "Idempotent replay; the secret is not returned again.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "ETag": {
                "description": "Resource version, `\"v{version}\"`.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"v[0-9]+\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookSecretResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/WriteBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "`webhook_endpoint_limit_reached`, `idempotency_conflict`, or `idempotency_in_progress`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "503": {
            "$ref": "#/components/responses/SecretUnavailable"
          }
        }
      }
    },
