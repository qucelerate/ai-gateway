{
  "openapi": "3.1.0",
  "info": {
    "title": "Gateway admin usage export API",
    "version": "1.0.0",
    "description": "An organization's export of settled usage to its own object storage: an S3 bucket, a Google Cloud Storage bucket or an Azure Blob container, written through one of the organization's stored cloud connections (an AWS role, an Entra app or a Google service account). The gateway stores no storage keys; the tenant grants that identity write access to the prefix.\n\nObjects: the worker queues one record per `inference.finalized` event dispatched for the organization from when the export was enabled, seals the queue every five minutes (or at 10,000 records) into batches of one hour of `finalized_at`, and writes each batch as gzip NDJSON (`application/gzip`) to `<prefix>/organization=<id>/date=YYYY-MM-DD/hour=HH/<first>-<last>.ndjson.gz`, where `<first>` and `<last>` are the outbox sequences of its first and last records. A retry rewrites the same object with the same records. Records are not in commit or `finalized_at` order across objects; each line is a `UsageRecord` and carries `event_id` and `trace_id` for deduplication. A trace finalized as `unknown` and settled later appears again; the record with the latest `finalized_at` per `trace_id` holds.\n\nFailure: writes retry with backoff from 5 seconds up to an hour. Records stay queued until written, or until the organization's usage retention period passes. An export whose writes have failed for an hour is `failing` here, counted by `gateway_usage_exports_failing`, and reported once through the `usage_export.failing` webhook event (`data` is `UsageExportFailing`). Authenticated with a session cookie or an agent token (`Authorization: Bearer gwa_\u2026`), which acts only in its agent's organization."
  },
  "security": [
    {
      "session": []
    },
    {
      "agentToken": []
    }
  ],
  "paths": {
    "/api/admin/v1/organizations/{org}/usage-export": {
      "get": {
        "operationId": "getUsageExport",
        "summary": "The organization's usage export",
        "description": "Permission `usage_export_read` (owner, admin, operator, auditor, read-only member; org-wide only). Not audited.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The export and its health.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "ETag": {
                "description": "The export's resource version, `\"v{version}\"`.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"v[0-9]+\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageExport"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "put": {
        "operationId": "setUsageExport",
        "summary": "Set the destination",
        "description": "Permission `usage_export_write` (owner, admin; org-wide only). Audited as `usage_export.set`. The gateway first writes `_gateway-verify.json` under the prefix through the connection; if that fails nothing is saved and the response is 422 `destination_unverified`. A new export covers usage finalized from now; a changed destination keeps the export's start, and records not yet written are written under the new destination. A replayed request is verified again before its recorded response is returned.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Client-chosen key. A retry with the same key and request replays the stored outcome; a different request under the same key is `idempotency_conflict`.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "`*` for any state, or the export's current `ETag`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsageExportInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated, or an idempotent replay of the recorded response.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "ETag": {
                "description": "The export's resource version, `\"v{version}\"`.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"v[0-9]+\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageExport"
                }
              }
            }
          },
          "201": {
            "description": "Created.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "ETag": {
                "description": "The export's resource version, `\"v{version}\"`.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"v[0-9]+\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageExport"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/WriteBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "delete": {
        "operationId": "deleteUsageExport",
        "summary": "Delete the export",
        "description": "Permission `usage_export_write`. Audited as `usage_export.deleted`. Records not yet written are discarded; objects already written are left in place.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "Organization id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Client-chosen key. A retry with the same key and request replays the stored outcome; a different request under the same key is `idempotency_conflict`.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "`*` for any state, or the export's current `ETag`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "200": {
            "description": "Idempotent replay of a completed delete.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "deleted"
                  ],
                  "properties": {
                    "deleted": {
                      "type": "boolean",
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/WriteBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-gateway_session",
        "description": "Paired with the `__Host-gateway_oidc_browser` binding cookie."
      },
      "agentToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "gwa_\u2026",
        "description": "An agent token (`Authorization: Bearer gwa_\u2026`), for automation: it acts as its agent, only in the agent's organization, with the agent's role. Created with `POST /api/admin/v1/organizations/{org}/agents/{agent_id}/tokens` or, on the server, `gateway agent create`."
      }
    },
    "responses": {
      "Unauthenticated": {
        "description": "`authentication_required`.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "`forbidden`: the actor lacks the required permission for the organization.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unavailable": {
        "description": "`service_unavailable` or `authentication_unavailable`.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Conflict": {
        "description": "`version_conflict` (stale `If-Match`), `idempotency_conflict`, or `idempotency_in_progress`.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "PreconditionRequired": {
        "description": "`if_match_required`: the `If-Match` header is missing.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "WriteBadRequest": {
        "description": "`idempotency_key_required`, `idempotency_key_invalid`, `if_match_invalid`, or a malformed JSON body (`request_body_invalid`).",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "`not_found`: the organization has no usage export.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "`invalid_usage_export` (the destination is not valid for its kind; `detail` says which field), or `destination_unverified`: the verification object could not be written, and `detail` ends with one of: `connection not found`, `connection cannot write to this kind of storage` (static keys, or a connection of another cloud), `connection's cloud principal is not approved`, `connection could not be opened`, `the gateway has no identity in this cloud`, `credentials could not be obtained`, `storage denied the write`, `bucket or container not found`, `bucket is in another region`, `storage returned an unexpected status`, `request timed out`, `connection to storage failed`, `request failed`.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "code",
          "title",
          "status",
          "detail",
          "instance",
          "request_id"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "StorageKind": {
        "type": "string",
        "enum": [
          "s3",
          "gcs",
          "azure_blob"
        ]
      },
      "UsageExportInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "connection",
          "bucket"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/StorageKind"
          },
          "connection": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "The adapter instance key of the organization's stored credential to write with: an AWS role (`s3`), an Entra directory (`azure_blob`) or a Google service account (`gcs`). Its cloud principal must be approved for the organization."
          },
          "bucket": {
            "type": "string",
            "minLength": 3,
            "maxLength": 222,
            "description": "The bucket, or the Azure container, under the service's naming rules."
          },
          "account": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9]{3,24}$",
            "description": "The Azure storage account; required for `azure_blob` and only for it."
          },
          "region": {
            "type": [
              "string",
              "null"
            ],
            "description": "The bucket's region (`eu-west-1`); required for `s3` and only for it."
          },
          "prefix": {
            "type": "string",
            "maxLength": 512,
            "default": "",
            "pattern": "^$|^[A-Za-z0-9_.=-]+(/[A-Za-z0-9_.=-]+)*$",
            "description": "Letters, digits and `- _ . = /`, without empty, `.` or `..` segments."
          }
        }
      },
      "UsageExport": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "connection",
          "bucket",
          "account",
          "region",
          "prefix",
          "enabled_at",
          "verified_at",
          "last_success_at",
          "failing",
          "failing_since",
          "last_error",
          "queued_records",
          "oldest_queued_at",
          "version",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/StorageKind"
          },
          "connection": {
            "type": "string"
          },
          "bucket": {
            "type": "string"
          },
          "account": {
            "type": [
              "string",
              "null"
            ]
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "prefix": {
            "type": "string"
          },
          "enabled_at": {
            "type": "string",
            "format": "date-time",
            "description": "Usage finalized from then on is exported."
          },
          "verified_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the destination was last set and verified."
          },
          "last_success_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "failing": {
            "type": "boolean",
            "description": "Writes have failed for an hour without a success since."
          },
          "failing_since": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The first failed write since the last success."
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ],
            "description": "The latest failure, as one of the phrases listed under `destination_unverified`."
          },
          "queued_records": {
            "type": "integer",
            "minimum": 0,
            "description": "Records not yet written."
          },
          "oldest_queued_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UsageRecord": {
        "type": "object",
        "additionalProperties": false,
        "description": "One line of an exported object. Metadata only: never prompts, completions or provider responses.",
        "required": [
          "schema",
          "event_id",
          "trace_id",
          "reservation_id",
          "organization_id",
          "team_id",
          "service_account_id",
          "end_user",
          "operation",
          "deployment",
          "model",
          "provider_family",
          "location",
          "outcome",
          "input_tokens",
          "output_tokens",
          "cached_input_tokens",
          "reasoning_tokens",
          "other_tokens",
          "usage_confidence",
          "usage_completeness",
          "pricing_confidence",
          "amount_minor",
          "currency",
          "recorded_at",
          "finalized_at",
          "batch_id",
          "custom_id",
          "model_master"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "const": "usage-export/v1"
          },
          "event_id": {
            "type": "string",
            "format": "uuid",
            "description": "The `inference.finalized` event; unique per record."
          },
          "trace_id": {
            "type": "string",
            "format": "uuid"
          },
          "reservation_id": {
            "type": "string",
            "format": "uuid"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "team_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "service_account_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "end_user": {
            "type": [
              "string",
              "null"
            ],
            "description": "The app\u2019s own id of the end user the request was for (D-028); `null` when it named none."
          },
          "operation": {
            "type": "string",
            "description": "The catalog operation of the route that served the request (`chat`, `embeddings`...; a streamed request is `chat`, or `chat_stream` on a release stored before streaming became a mode of chat), or `inference` for a request not routed by the catalog."
          },
          "deployment": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": "string"
          },
          "provider_family": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "type": "string",
            "description": "`settled`, `unknown`, `bound-breach`, `expired`, `input-count-drift`, `operator-resolved`, `failed-over` (an attempt released, charging nothing, when the request failed over to another deployment of its route), or `refused` (released at zero: every deployment tried refused it before any work, such as with a 429)."
          },
          "input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "cached_input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "reasoning_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "other_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "usage_confidence": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "exact",
              "estimated",
              "unknown",
              null
            ]
          },
          "usage_completeness": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "complete",
              "partial",
              "unavailable",
              null
            ]
          },
          "pricing_confidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "amount_minor": {
            "type": [
              "integer",
              "null"
            ],
            "description": "In minor units of `currency`; null when unpriced."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "finalized_at": {
            "type": "string",
            "format": "date-time"
          },
          "batch_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^batch_[0-9a-f-]{36}$",
            "description": "The batch the request was a line of, as the batches API names it (`batch_<uuid>`); `null` for a request made on its own."
          },
          "custom_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512,
            "description": "The line's `custom_id` in its batch; `null` for a request made on its own."
          },
          "model_master": {
            "type": [
              "string",
              "null"
            ],
            "description": "The master record (one model across providers, D-033: a model card's id such as `anthropic/claude-sonnet-4-6`, or the organization's `org/<slug>`) the request's deployment was linked to when it was served; `null` for none (no card matched, linked to none, no catalog provenance, or admitted before migration 0141)."
          }
        }
      },
      "UsageExportFailing": {
        "type": "object",
        "additionalProperties": false,
        "description": "`data` of the `usage_export.failing` webhook event.",
        "required": [
          "export_id",
          "kind",
          "failing_since",
          "last_error",
          "queued_records"
        ],
        "properties": {
          "export_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/StorageKind"
          },
          "failing_since": {
            "type": "string",
            "format": "date-time"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "queued_records": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
