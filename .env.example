# Copy to .env and replace both password placeholders with different,
# randomly generated local-only values. Do not commit .env.
POSTGRES_DB=gateway
POSTGRES_ADMIN_USER=gateway_bootstrap_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_ADMIN_PASSWORD
GATEWAY_APP_USER=gateway_app
GATEWAY_APP_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_APP_PASSWORD

DATABASE_URL=postgres://gateway_app:REPLACE_WITH_RANDOM_LOCAL_APP_PASSWORD@localhost:5432/gateway
# Database connections per pool (10 by default, 1 to 1000; see
# the operations guide (https://gateway.qucelerate.com/operations/), Capacity). `api` and `worker` open one pool each;
# `all-in-one` opens both, so up to twice this.
# GATEWAY_DATABASE_MAX_CONNECTIONS=10
# Largest inference request body (4 MiB by default, 65536 to 67108864
# bytes); other routes accept 256 KiB.
# GATEWAY_INFERENCE_MAX_BODY_BYTES=4194304
# Budget leases (off by default): each process reserves requests against
# a small lease of a budget instead of locking the budget for each one,
# for one budget past about 250 requests a second (the operations guide (https://gateway.qucelerate.com/operations/)).
# GATEWAY_BUDGET_LEASES=false
# Rate-limit leases (off by default): each process admits requests against
# a lease of up to a second of admissions instead of locking the
# organization's rate-limit policy for each one (the operations guide (https://gateway.qucelerate.com/operations/)).
# GATEWAY_RATE_LIMIT_LEASES=false
# 127.0.0.1:3000 or [::1]:3000 for this machine only; [::]:3000 for every
# interface, IPv4 and IPv6 alike.
BIND_ADDR=127.0.0.1:3000
# all-in-one, api, worker or data-plane (inference only; see the operations guide (https://gateway.qucelerate.com/operations/)).
GATEWAY_PROFILE=all-in-one
API_KEY_PEPPER=REPLACE_WITH_RANDOM_LOCAL_API_KEY_PEPPER

# Sign-in. Local accounts (email and password, kept by the gateway) need
# only GATEWAY_ORIGIN and the two session secrets below; with them set, the
# first start logs a setup link that creates the first organization and its
# owner. Generate each secret with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# GATEWAY_LOCAL_ACCOUNTS=false turns local accounts off.
# GATEWAY_LOCAL_ACCOUNTS=true
# Let any signed-in person create an organization (off: only deployment
# administrators can).
# GATEWAY_SELF_SERVE_ORGANIZATIONS=true
# Behind a reverse proxy that sets X-Forwarded-For (Compose's does), take the
# client address for sign-in limits from it.
# GATEWAY_TRUST_X_FORWARDED_FOR=true

# OIDC is fail-closed unless explicitly enabled and fully configured.
OIDC_ENABLED=false
GATEWAY_ORIGIN=http://127.0.0.1:3000
OIDC_ISSUER=https://issuer.example.invalid
OIDC_AUDIENCE=gateway
OIDC_CLIENT_ID=gateway-local
# Set for providers that issue the gateway a client secret (most web-app
# registrations: Entra ID, Google, Okta); leave unset for a public client.
# OIDC_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
OIDC_REDIRECT_URI=http://127.0.0.1:3000/api/admin/v1/oidc/callback
OIDC_SESSION_HMAC_SECRET=REPLACE_WITH_32_BYTE_BASE64_SECRET
OIDC_SESSION_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
OIDC_SESSION_TTL_SECONDS=3600

# Optional 32-byte key (base64url) that seals provider credentials stored
# through the admin catalog API. Without it, credential writes return 503.
# Keep it apart from the session keys; losing it makes stored credentials
# unreadable. A stored credential overrides the process credential below for
# its adapter instance key and reuses that key's endpoint and limits. Keys
# without process configuration accept stored credentials only for openai,
# anthropic, and gemini, which have fixed public endpoints.
# GATEWAY_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY

# Optional AWS KMS envelope encryption for stored secrets. With a KMS key set,
# secrets are sealed under a KMS-generated data key and the worker re-seals
# existing ones automatically (the key above, if set, keeps opening what it
# sealed until then). Set it on every process. Region falls back to
# AWS_REGION; credentials to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_SESSION_TOKEN. The role needs kms:GenerateDataKey and kms:Decrypt.
# GATEWAY_CREDENTIAL_KMS_KEY_ID=alias/gateway-credentials
# GATEWAY_CREDENTIAL_KMS_REGION=us-east-1
# GATEWAY_CREDENTIAL_KMS_AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY_ID
# GATEWAY_CREDENTIAL_KMS_AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_ACCESS_KEY

# Where traced request content is kept (tracing is off until an organization
# turns it on). Content is encrypted before it is sent, under keys sealed by
# the credential keyring above, so one of them must be set too. An endpoint
# names an S3-compatible store (path-style); without one the bucket is on AWS
# S3. Credentials fall back to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, then
# the runtime identity. Set it on the API and the worker. Without a store,
# traces keep timing only. Each side of a request is capped at
# GATEWAY_TRACE_CONTENT_MAX_BYTES (5 MiB by default, 1 KiB to 64 MiB).
# GATEWAY_TRACE_STORE_BUCKET=gateway-traces
# GATEWAY_TRACE_STORE_REGION=us-east-1
# GATEWAY_TRACE_STORE_ENDPOINT=https://s3.example.com
# GATEWAY_TRACE_STORE_PREFIX=dev/
# GATEWAY_TRACE_STORE_AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY_ID
# GATEWAY_TRACE_STORE_AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_ACCESS_KEY
# GATEWAY_TRACE_CONTENT_MAX_BYTES=5242880

# Optional ClickHouse analytics sink (the operations guide (https://gateway.qucelerate.com/operations/), Analytics in
# ClickHouse): the usage dashboard, the usage report and trace search read
# from ClickHouse once it holds a full copy; budgets and settlement never do.
# Set it on the worker (which writes) and the API (which reads). Unset: off,
# and everything reads PostgreSQL. The password is read like the others here,
# so keep it in the same secret. A CA file adds a private CA for https.
# GATEWAY_CLICKHOUSE_URL=https://clickhouse.analytics.svc:8443
# GATEWAY_CLICKHOUSE_DATABASE=gateway
# GATEWAY_CLICKHOUSE_USER=gateway
# GATEWAY_CLICKHOUSE_PASSWORD=REPLACE_WITH_CLICKHOUSE_PASSWORD
# GATEWAY_CLICKHOUSE_CA_FILE=/etc/gateway/clickhouse-ca.pem

# Operator model card and data-handling files (the operations guide (https://gateway.qucelerate.com/operations/), Card
# files), added to and replacing the ones shipped in model-cards/. Read by
# the API at start-up.
# GATEWAY_MODEL_CARDS_DIR=/etc/gateway/model-cards
# The Hugging Face Hub model card imports read (catalog writers import a
# Hub card for a model no card file covers). Unset: imports are off.
# GATEWAY_MODEL_CARD_HUB_URL=https://huggingface.co

# The worker compares catalog prices with the Azure Retail Prices API and the
# AWS Price List daily (never applying them). Set `none`, or list
# `azure-retail` and/or `aws-price-list`; unset fetches both.
# GATEWAY_PUBLIC_PRICE_SOURCES=azure-retail,aws-price-list
# GATEWAY_AZURE_RETAIL_PRICE_CURRENCIES=USD

# Optional Prometheus metrics listener, apart from the API. It has no
# authentication: bind it to loopback or a private interface. See
# the operations guide (https://gateway.qucelerate.com/operations/) for the metrics and suggested alerts.
# GATEWAY_METRICS_ADDR=127.0.0.1:9464

# Optional TLS (HTTP/2, HTTP/1.1) and QUIC (HTTP/3) listeners beside BIND_ADDR;
# see the operations guide (https://gateway.qucelerate.com/operations/), "HTTP protocols, TLS and HTTP/3".
# GATEWAY_TLS_CERT_FILE=/etc/gateway/tls/tls.crt
# GATEWAY_TLS_KEY_FILE=/etc/gateway/tls/tls.key
# GATEWAY_TLS_ADDR=[::]:8443
# GATEWAY_HTTP3_ADDR=[::]:8443
# GATEWAY_ALT_SVC='h3=":443"; ma=86400'

# How this process reports itself in gateway.gateway_instance, and how often
# it reads the configuration feed (1-300 seconds). See the operations guide (https://gateway.qucelerate.com/operations/).
# GATEWAY_INSTANCE_ID=gateway-1
# GATEWAY_REGION=eu-west-1
# GATEWAY_BUILD=2017ab33b970
# GATEWAY_CONFIG_POLL_SECONDS=5



# Optional OpenAI-compatible inference provider. Leave OPENAI_API_KEY unset to
# disable the adapter. OPENAI_BASE_URL defaults to the OpenAI API endpoint.
# OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_REQUEST_TIMEOUT_SECONDS=60
# OPENAI_CONNECT_TIMEOUT_SECONDS=10
# OPENAI_MAX_RESPONSE_BYTES=8388608
# OPENAI_ADAPTER_INSTANCE_KEY=openai-main

# Optional Anthropic Messages adapter. Catalog routes reference only a trusted
# adapter key; the credential is this process configuration unless the
# organization stored its own.
# ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_REQUEST_TIMEOUT_SECONDS=60
# ANTHROPIC_CONNECT_TIMEOUT_SECONDS=10
# ANTHROPIC_MAX_RESPONSE_BYTES=1048576

# Optional Gemini adapter: the Gemini API with GEMINI_API_KEY, or, without a
# key, Gemini Enterprise Agent Platform (formerly Vertex AI) in
# GEMINI_AGENT_PLATFORM_PROJECT with the gateway's Google identity
# (Application Default Credentials: GOOGLE_APPLICATION_CREDENTIALS, gcloud's
# application default credentials, or the host's metadata server). The
# Gemini API no longer admits new service accounts; GEMINI_QUOTA_PROJECT
# keeps an identity it already admitted on the Gemini API, billed to that
# project. GEMINI_BASE_URL replaces the endpoint (the Agent Platform
# publisher URL in that mode).
# GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
# GEMINI_AGENT_PLATFORM_PROJECT=REPLACE_WITH_GCP_PROJECT_ID
# GEMINI_AGENT_PLATFORM_LOCATION=global
# GEMINI_QUOTA_PROJECT=REPLACE_WITH_GCP_PROJECT_ID
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_REQUEST_TIMEOUT_SECONDS=60
# GEMINI_CONNECT_TIMEOUT_SECONDS=10
# GEMINI_MAX_RESPONSE_BYTES=8388608
# GEMINI_ADAPTER_INSTANCE_KEY=gemini-main

# Optional AWS Bedrock adapter (Converse/ConverseStream), enabled by
# BEDROCK_AWS_REGION. With the region alone the gateway uses the AWS role it
# runs as (EKS IRSA or Pod Identity, ECS task role, EC2 instance profile);
# static keys are a fallback. Tenants can store a role ARN that the gateway
# assumes with this identity. BEDROCK_BASE_URL defaults to the regional
# Bedrock Runtime endpoint derived from BEDROCK_AWS_REGION.
# BEDROCK_AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
# BEDROCK_AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
# BEDROCK_AWS_SESSION_TOKEN=REPLACE_WITH_AWS_SESSION_TOKEN
# BEDROCK_AWS_REGION=us-east-1
# BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com
# Model discovery calls the control plane, which defaults to the same region.
# BEDROCK_CONTROL_BASE_URL=https://bedrock.us-east-1.amazonaws.com
# STS for tenant roles, defaults to the regional endpoint (set for a VPC endpoint).
# BEDROCK_STS_ENDPOINT=https://sts.us-east-1.amazonaws.com
# BEDROCK_REQUEST_TIMEOUT_SECONDS=60
# BEDROCK_CONNECT_TIMEOUT_SECONDS=10
# BEDROCK_MAX_RESPONSE_BYTES=8388608
# BEDROCK_ADAPTER_INSTANCE_KEY=bedrock-main

# Optional Azure OpenAI adapter, enabled by AZURE_OPENAI_BASE_URL, the
# per-resource endpoint (e.g. https://<resource>.openai.azure.com). With
# AZURE_OPENAI_API_KEY it authenticates with the key; without, with the
# gateway's Microsoft Entra identity (see below). A distinct catalog family
# from Azure AI Foundry.
# AZURE_OPENAI_API_KEY=REPLACE_WITH_AZURE_OPENAI_API_KEY
# AZURE_OPENAI_BASE_URL=https://REPLACE_WITH_RESOURCE_NAME.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_REQUEST_TIMEOUT_SECONDS=60
# AZURE_OPENAI_CONNECT_TIMEOUT_SECONDS=10
# AZURE_OPENAI_MAX_RESPONSE_BYTES=8388608
# AZURE_OPENAI_ADAPTER_INSTANCE_KEY=azure-openai-main

# Optional Azure AI Foundry model inference adapter, enabled by
# AZURE_AI_FOUNDRY_BASE_URL, the per-resource endpoint (e.g.
# https://<resource>.services.ai.azure.com). With AZURE_AI_FOUNDRY_API_KEY it
# authenticates with the key; without, with the gateway's Entra identity. A
# distinct catalog family from Azure OpenAI: the deployment name is sent in
# the request body (not the URL path), and auth uses an Authorization:
# Bearer header (not api-key).
# AZURE_AI_FOUNDRY_API_KEY=REPLACE_WITH_AZURE_AI_FOUNDRY_API_KEY
# AZURE_AI_FOUNDRY_BASE_URL=https://REPLACE_WITH_RESOURCE_NAME.services.ai.azure.com
# AZURE_AI_FOUNDRY_API_VERSION=2024-05-01-preview
# AZURE_AI_FOUNDRY_REQUEST_TIMEOUT_SECONDS=60
# AZURE_AI_FOUNDRY_CONNECT_TIMEOUT_SECONDS=10
# AZURE_AI_FOUNDRY_MAX_RESPONSE_BYTES=8388608
# AZURE_AI_FOUNDRY_ADAPTER_INSTANCE_KEY=azure-ai-foundry-main

# The gateway's Microsoft Entra identity, for the Azure adapters without a
# key and for tenants' Entra directories. A client secret, or workload
# identity federation (AKS sets AZURE_FEDERATED_TOKEN_FILE); with neither,
# the host's managed identity (AZURE_CLIENT_ID picks a user-assigned one).
# AZURE_TENANT_ID=REPLACE_WITH_DIRECTORY_ID
# AZURE_CLIENT_ID=REPLACE_WITH_APPLICATION_ID
# AZURE_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# AZURE_AUTHORITY_HOST=https://login.microsoftonline.com

# Optional generic OpenAI-compatible adapter, for third-party or self-hosted
# servers implementing the OpenAI Chat Completions wire format (e.g. vLLM,
# LiteLLM proxy, LocalAI, llama.cpp server). This family must be explicitly
# trusted and constrained: compatibility with the wire format is not proof
# of identical semantics. OPENAI_COMPATIBLE_BASE_URL alone enables the
# adapter; OPENAI_COMPATIBLE_API_KEY is independently optional (some
# self-hosted servers require no auth). Only enable
# OPENAI_COMPATIBLE_REQUEST_STREAM_USAGE, or declare an embeddings
# capability for a deployment routed to this family, once you have verified
# your specific backend actually supports it.
# OPENAI_COMPATIBLE_BASE_URL=https://REPLACE_WITH_COMPATIBLE_ENDPOINT/v1
# OPENAI_COMPATIBLE_API_KEY=REPLACE_WITH_OPENAI_COMPATIBLE_API_KEY
# OPENAI_COMPATIBLE_EXTRA_HEADERS={"x-tenant-id":"REPLACE_WITH_TENANT_ID"}
# OPENAI_COMPATIBLE_REQUEST_STREAM_USAGE=false
# OPENAI_COMPATIBLE_REQUEST_TIMEOUT_SECONDS=60
# OPENAI_COMPATIBLE_CONNECT_TIMEOUT_SECONDS=10
# OPENAI_COMPATIBLE_MAX_RESPONSE_BYTES=8388608
# OPENAI_COMPATIBLE_ADAPTER_INSTANCE_KEY=openai-compatible-main

# Migrations run only through the explicit command: cargo run -- migrate
# Optional smoke path: docker compose up -d postgres, then run that command.
ANTHROPIC_ADAPTER_INSTANCE_KEY=anthropic-main
